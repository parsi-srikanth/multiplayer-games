{
  "name": "parsi-games",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.test.json && tsc -p tsconfig.worker-test.json && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "test": "vitest run && vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest",
    "cf:typegen": "wrangler types",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "smoke:full-stack": "node scripts/full-stack-smoke.mjs",
    "check": "npm run cf:typegen && npm run typecheck && npm run test && npm run lint && npm run build"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "latest",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "axe-core": "^4.13.0",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "jsdom": "^30.0.1",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest",
    "ws": "^8.21.3"
  }
}
